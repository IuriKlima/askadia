# Copy to .env in the repository root. Web, API and worker load this file.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:3000
WORKER_HEALTH_PORT=4001
# Optional locally. Required to process background jobs.
REDIS_URL=
# Supabase identity requires both URL and public anon/publishable key. Never use a service key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
API_INTERNAL_URL=http://127.0.0.1:4000
# Reserved for later integrations; not used by identity.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
ASAAS_API_KEY=
# Reserved for application email delivery. Auth emails use SMTP configured in Supabase.
RESEND_API_KEY=

# Current alternative to SUPABASE_ANON_KEY; set one public key, never a secret key.
SUPABASE_PUBLISHABLE_KEY=
# URLs and later integrations require their own setup and validation.
APP_BASE_URL=
PUBLIC_SITE_URL=
CUSTOMER_SITES_BASE_DOMAIN=
DATABASE_URL=
# Used by the persisted company journey. Requires API billing and model access.
OPENAI_MODEL_STRATEGY=gpt-5.4
OPENAI_MODEL_COPY=gpt-5.4-mini
OPENAI_MODEL_CHAT=gpt-5.4-mini
GEMINI_API_KEY=
# Requested default; account availability must be validated before use.
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_PLACES_SERVER_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=
ASAAS_WEBHOOK_AUTH_TOKEN=
ASAAS_ENVIRONMENT=sandbox
EMAIL_FROM=
HOSTING_PROVIDER_TOKEN=
HOSTING_PROJECT_ID=
SECRETS_ENCRYPTION_KEY=
# Evolution transport is pending; these variables alone do not connect WhatsApp.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Instance name is computed per company: askadia-{companyId}. No shared instance.
EVOLUTION_WEBHOOK_SECRET=

# Consumer for new WhatsApp messages; activation remains explicit per company/channel.
INBOX_AUTOMATION_ENABLED=false

# Scheduled relationship campaigns. Requires migrations 006-008 and explicit activation per campaign.
MESSAGE_CAMPAIGNS_ENABLED=false
