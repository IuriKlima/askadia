# Copy to .env in the repository root. Web, API and worker load this file.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:3000
WORKER_HEALTH_PORT=4001
# Optional locally. Required to process background jobs.
REDIS_URL=
# Supabase identity requires both URL and public anon/publishable key. Never use a service key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
API_INTERNAL_URL=http://127.0.0.1:4000
# Reserved for later integrations; not used by identity.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
ASAAS_API_KEY=
# Reserved for application email delivery. Auth emails use SMTP configured in Supabase.
RESEND_API_KEY=

# Current alternative to SUPABASE_ANON_KEY; set one public key, never a secret key.
SUPABASE_PUBLISHABLE_KEY=
# URLs and later integrations require their own setup and validation.
APP_BASE_URL=
PUBLIC_SITE_URL=
CUSTOMER_SITES_BASE_DOMAIN=
DATABASE_URL=
# Used by the persisted company journey. Requires API billing and model access.
OPENAI_MODEL_STRATEGY=gpt-6-astra
OPENAI_MODEL_COPY=gpt-6-sol
OPENAI_MODEL_CHAT=gpt-6-luna
# Optional: visual descriptions of uploaded materials. Image generation uses OpenAI.
GEMINI_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_PLACES_SERVER_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=
ASAAS_WEBHOOK_AUTH_TOKEN=
ASAAS_ENVIRONMENT=sandbox
EMAIL_FROM=
HOSTING_PROVIDER_TOKEN=
HOSTING_PROJECT_ID=
SECRETS_ENCRYPTION_KEY=
# Evolution transport is pending; these variables alone do not connect WhatsApp.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Instance name is computed per company: askadia-{companyId}. No shared instance.
EVOLUTION_WEBHOOK_SECRET=

# Consumer for new WhatsApp messages; activation remains explicit per company/channel.
INBOX_AUTOMATION_ENABLED=false

# Scheduled relationship campaigns. Requires migrations 006-008 and explicit activation per campaign.
MESSAGE_CAMPAIGNS_ENABLED=false

# Google Ads: OAuth web client and approved developer token; no credentials in git
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_API_VERSION=v25
# Hosted company sites: CNAME target and optional IPv4 for apex domains
SITES_CNAME_TARGET=askadia.com.br
SITES_SERVER_IP=

# Optional domain + HTTPS automation (server-only token restricted to Askadia project)
EASYPANEL_API_URL=
EASYPANEL_API_TOKEN=
EASYPANEL_SITE_PROJECT=askadia
EASYPANEL_SITE_SERVICE=askadia
EASYPANEL_CERTIFICATE_RESOLVER=

SITES_PLATFORM_DOMAIN=askadia.com.br
OPENAI_MODEL_SITE=gpt-6-astra
GEMINI_DESCRIPTION_MODEL=gemini-3.5-flash-lite
IMAGE_DESCRIPTIONS_ENABLED=true
# Automatic draft preparation after confirmed onboarding (never publishes)
CONTENT_AUTOPREP_ENABLED=true

# Public Askadia business channels (displayed on Contato/Suporte; never use private credentials)
PUBLIC_SALES_WHATSAPP=
PUBLIC_CONTACT_EMAIL=
PUBLIC_SUPPORT_EMAIL=

# Optional server-side Google Trends data provider (official embeds work without this)
SERPAPI_API_KEY=

# Preparação de campanhas e atendimento (homologar acesso ao modelo antes de ativar)
OPENAI_MODEL_ORCHESTRATOR=gpt-6-astra
OPENAI_MODEL_SEARCH=gpt-6-luna
# Ativar somente após homologar Business Discovery com a autorização Meta da empresa
INSTAGRAM_MONITOR_ENABLED=false
OPENAI_MODEL_ADS=gpt-6-astra
OPENAI_MODEL_ATTENDANCE=gpt-6-luna

# Fila persistente de edição de fotos e criativos; exige migração 202609270001.
VISUAL_JOBS_ENABLED=true

# OpenAI image generation and editing (API, billed separately).
OPENAI_MODEL_IMAGE=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high

# Enable after migrations; only version-approved campaigns can execute.
ADS_EXECUTION_ENABLED=false

# Simulação explícita sem cobrança; acesso de teste por empresa por 7 dias.
# disabled bloqueia novas simulações; acessos emitidos expiram ou devem ser revogados.
CHECKOUT_MODE=test

# Canal público do especialista de suporte (DDI + DDD + número, fictício)
PUBLIC_SUPPORT_WHATSAPP=5511999999999
